---
import Base from '../layouts/Base.astro';
import {SiteApp} from '../react/SiteApp';
export function getStaticPaths(){return Object.values(import.meta.glob('../../content/articles/*.json',{eager:true,import:'default'})).filter((a:any)=>a.status==='published').map((a:any)=>({params:{slug:a.slug},props:{article:a}}))}
const {article}=Astro.props;
---
<Base title={article.metaTitle||article.title} description={article.metaDescription||article.description} pathname={'/'+article.slug+'/'} type="article"><SiteApp type="article" slug={article.slug} client:load /></Base>
